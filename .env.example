# ==============================================================================
# EISD One — Environment Variables Template (Lean Fullstack — 2 Container)
# Salin ke .env untuk lokal. JANGAN commit file .env!
# ==============================================================================

NODE_ENV=development
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:3000

# PostgreSQL
POSTGRES_USER=eisd
POSTGRES_PASSWORD=eisd_dev_password_change_me
POSTGRES_DB=eisd_one
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eisd:eisd_dev_password_change_me@localhost:5432/eisd_one?schema=public
DIRECT_URL=postgresql://eisd:eisd_dev_password_change_me@localhost:5432/eisd_one?schema=public

# Auth & Session (JWT httpOnly Cookie)
JWT_SECRET=replace_with_at_least_32_chars_random_secret_in_production
COOKIE_SECURE=false

# Google Login (opsional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Daftar domain email dipisahkan koma (kosong = izinkan semua domain saat dev)
AUTH_ALLOWED_EMAIL_DOMAINS=

# Folder penyimpanan upload lokal
UPLOAD_DIR=./uploads

# Password akun seed dev (hanya dipakai saat NODE_ENV !== production)
SEED_ADMIN_PASSWORD=AdminEisd123!
